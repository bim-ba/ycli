{
  "mcpServers": {
    "yandex-360": {
      "command": "uvx",
      "args": ["--from", "yandex-cli[mcp]", "ycli", "mcp", "start"],
      "env": {
        "YANDEX_ID_OAUTH_TOKEN": "${YANDEX_ID_OAUTH_TOKEN}",
        "YANDEX_ID_ORGANIZATION_ID": "${YANDEX_ID_ORGANIZATION_ID}",
        "YANDEX_CLOUD_IAM_TOKEN": "${YANDEX_CLOUD_IAM_TOKEN}",
        "YANDEX_CLOUD_ORGANIZATION_ID": "${YANDEX_CLOUD_ORGANIZATION_ID}",
        "YANDEX_CLOUD_SERVICE_ACCOUNT_KEY_ID": "${YANDEX_CLOUD_SERVICE_ACCOUNT_KEY_ID}",
        "YANDEX_CLOUD_SERVICE_ACCOUNT_ID": "${YANDEX_CLOUD_SERVICE_ACCOUNT_ID}",
        "YANDEX_CLOUD_SERVICE_ACCOUNT_PRIVATE_KEY": "${YANDEX_CLOUD_SERVICE_ACCOUNT_PRIVATE_KEY}"
      }
    }
  }
}
