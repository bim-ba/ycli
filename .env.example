# OAuth for Yandex 360. Fastest setup: `ycli auth login`.
YANDEX_ID_OAUTH_TOKEN=
YANDEX_ID_ORGANIZATION_ID=

# Static IAM for a Yandex Cloud organization (alternative to OAuth above).
YANDEX_CLOUD_IAM_TOKEN=
YANDEX_CLOUD_ORGANIZATION_ID=

# Dynamic service-account IAM for Tracker only (alternative to static IAM).
# Yandex support must enable the service account for the Tracker cloud organization.
YANDEX_CLOUD_SERVICE_ACCOUNT_KEY_ID=
YANDEX_CLOUD_SERVICE_ACCOUNT_ID=
YANDEX_CLOUD_SERVICE_ACCOUNT_PRIVATE_KEY=

# OAuth app — only needed to run `ycli auth login`.
# Register one at https://oauth.yandex.ru/client/new (grant Tracker/Wiki/Forms).
# client id + secret => headless device flow; client id alone => browser flow.
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
