# Yandex 360 API credentials — the two vars ycli needs.
# Fastest way to fill them: `ycli auth login` (see README → Configure).
YANDEX_ID_OAUTH_TOKEN=
YANDEX_ID_ORGANIZATION_ID=

# OAuth app — only needed to run `ycli auth login`.
# Register one at https://oauth.yandex.ru/client/new (grant Tracker/Wiki/Forms).
# client id + secret => headless device flow; client id alone => browser flow.
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
